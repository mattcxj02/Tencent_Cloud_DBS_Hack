# DCTA .env.example — placeholder values only. Never commit real secrets.
# The user supplies credentials manually in .env (never read/edited by tooling).

# ── LLM providers (OpenAI-compatible). Each service picks one: tokenhub | deepseek ──
tokenhub_key=thk-placeholder-replace-with-real-key
deepseek_key=sk-placeholder-replace-with-real-key
EXTRACT_PROVIDER=tokenhub
EXTRACT_MODEL=hy3
EXTRACT_MAX_TOKENS=4096
# Per provider request. Delegated runs cap this to the remaining shared deadline
# and disable SDK retries; EXTRACT_MAX_RETRIES applies to standalone extraction only.
EXTRACT_TIMEOUT_SECONDS=40
EXTRACT_MAX_RETRIES=0
# Empty preserves today's request. TokenHub hy3: no_think | low | high.
# TokenHub mimo-v2.6-flash: no_think only (mapped to thinking.type=disabled).
# DeepSeek direct/other models: leave empty. Restart the agent after changes.
# 1024 tokens is an evaluation candidate only; keep 4096 until quality is verified.
EXTRACT_REASONING_EFFORT=
# deepseek-v4-flash must be activated under TokenHub "Online Inference Service" before
# switching the validator to tokenhub; until then use DeepSeek directly.
VALIDATE_PROVIDER=deepseek
VALIDATE_MODEL=deepseek-flash
VALIDATE_MAX_TOKENS=4096
# Gateway → agent call timeout (hy3 can take >15 s)
AGENT_TIMEOUT_SECONDS=45
# Overall drafting budget, including admission, readiness, extraction and validation.
DRAFT_TIMEOUT_SECONDS=90
VALIDATE_TIMEOUT_SECONDS=30
VALIDATOR_CLIENT_TIMEOUT_SECONDS=40

# ── TRTC ASR (gateway only) — NOT cloud API SecretId/SecretKey ──
SDKAppID=0
SDKSecretKey=trtc-placeholder-replace-with-real-key
TRTC_ASR_HOST=asr-intl.cloud-rtc.com

# ── Langfuse Cloud (all services) ──
LANGFUSE_PUBLIC_KEY=lf-placeholder-public
LANGFUSE_SECRET_KEY=lf-placeholder-secret
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# ── Gateway-only configuration (non-secret defaults) ──
DCTA_DB_PATH=data/dcta.db
# Simulated step-up channel (gateway only): OPERATOR_TOKEN requires >=32 chars;
# empty/short disables delivery but does not block otherwise eligible drafting.
OPERATOR_TOKEN=
# >=32 chars for codes to survive a gateway restart; empty/short uses a per-process secret.
STEP_UP_SECRET=
# Leave empty for a random per-process delegation secret in dev, or set >=32 random chars.
GATEWAY_DELEGATION_SECRET=

# ── Gateway <-> validator shared secret (gateway and validator only, never the agent) ──
# Required: the SAME >=32-character secret in gateway and validator (never agent).
# If missing, short or mismatched, drafting fails before extraction. Restart both
# services after changing it; GET /api/ready verifies authenticated service connectivity.
# Presence alone does not prove provider access; model calls still fail closed.
#   python -c 'import secrets; print(secrets.token_urlsafe(48))'
VALIDATOR_SERVICE_TOKEN=
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_ORIGIN=http://localhost:5173
NONCE_TTL_SECONDS=120
MANDATE_PER_LEG=1000.00
MANDATE_DAILY=3000.00
RISK_THRESHOLD=500.00
COOLING_HOURS=12
DCTA_TIMEZONE=Asia/Singapore
