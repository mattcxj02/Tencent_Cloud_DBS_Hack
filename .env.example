# DCTA .env.example — placeholder values only. Never commit real secrets.
# The user supplies credentials manually in .env (never read/edited by tooling).

# ── LLM providers (OpenAI-compatible). Each service picks one: tokenhub | deepseek ──
tokenhub_key=thk-placeholder-replace-with-real-key
deepseek_key=sk-placeholder-replace-with-real-key
EXTRACT_PROVIDER=tokenhub
EXTRACT_MODEL=hy3
EXTRACT_MAX_TOKENS=4096
# deepseek-v4-flash must be activated under TokenHub "Online Inference Service" before
# switching the validator to tokenhub; until then use DeepSeek directly.
VALIDATE_PROVIDER=deepseek
VALIDATE_MODEL=deepseek-flash
VALIDATE_MAX_TOKENS=4096
# Gateway → agent call timeout (hy3 can take >15 s)
AGENT_TIMEOUT_SECONDS=45

# ── TRTC ASR (gateway only) — NOT cloud API SecretId/SecretKey ──
SDKAppID=0
SDKSecretKey=trtc-placeholder-replace-with-real-key
TRTC_ASR_HOST=asr-intl.cloud-rtc.com

# ── Langfuse Cloud (all services) ──
LANGFUSE_PUBLIC_KEY=lf-placeholder-public
LANGFUSE_SECRET_KEY=lf-placeholder-secret
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# ── Gateway-only configuration (non-secret defaults) ──
DCTA_DB_PATH=data/dcta.db
# Leave empty for a random per-process secret in dev, or set >=32 random chars:
#   python -c 'import secrets; print(secrets.token_urlsafe(48))'
# Simulated step-up channel (gateway only). Leave empty to disable the operator console.
OPERATOR_TOKEN=
STEP_UP_SECRET=
GATEWAY_DELEGATION_SECRET=

# ── Gateway <-> validator shared secret (gateway and validator only, never the agent) ──
# Required: >=32 random chars. If unset or shorter, the validator refuses every request.
#   python -c 'import secrets; print(secrets.token_urlsafe(48))'
VALIDATOR_SERVICE_TOKEN=
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_ORIGIN=http://localhost:5173
NONCE_TTL_SECONDS=120
MANDATE_PER_LEG=1000.00
MANDATE_DAILY=3000.00
RISK_THRESHOLD=500.00
COOLING_HOURS=12
DCTA_TIMEZONE=Asia/Singapore
